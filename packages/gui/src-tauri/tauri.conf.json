{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Learn Anything",
  "version": "0.1.0",
  "identifier": "com.learnanything.gui",
  "build": {
    "beforeDevCommand": "pnpm run build:sidecar && vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build:all",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Learn Anything",
        "width": 1200,
        "height": 800,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/sidecar"]
  }
}
